<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetSicilyLines.Coordonnees"
             Title="Mes coordonnées"
             Background="White">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Image Source="gospel1.png" HeightRequest="80" HorizontalOptions="Center" />
            <Label Text="Nom" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryNom" BackgroundColor="Black" TextColor="White" IsReadOnly="True"/>
            <Label Text="Prénom" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryPrenom" BackgroundColor="Black" TextColor="White" IsReadOnly="True"/>
            <Label Text="Email" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryEmail" BackgroundColor="Black" TextColor="White"/>
            <Label Text="Téléphone" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryTelephone" Keyboard="Telephone" BackgroundColor="Black" TextColor="White"/>
            <Label Text="Adresse" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryAdresse" BackgroundColor="Black" TextColor="White"/>
            <Label Text="Ville" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryVille" BackgroundColor="Black" TextColor="White"/>
            <Label Text="Code Postal" TextColor="Black" FontAttributes="Bold"/>
            <Entry x:Name="EntryCodePostal" Keyboard="Numeric" BackgroundColor="Black" TextColor="White"/>
            <Button Text="Enregistrer" BackgroundColor="Blue" TextColor="White" Clicked="BtnEnregistrer_Clicked"/>
            <Button Text="Se déconnecter" BackgroundColor="Gray" TextColor="White" Clicked="BtnDeconnexion_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>